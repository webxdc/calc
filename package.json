{
  "name": "Calc",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:webxdc": "concurrently \"vite\" \"webxdc-dev run http://localhost:5173\"",
    "webxdc:xdc": "pnpm build && webxdc-dev run dist-xdc/calc.xdc",
    "webxdc:dist": "pnpm build && webxdc-dev run dist",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@ironcalc/workbook": "link:vendor/ironcalc/webapp/IronCalc",
    "@webxdc/types": "^2.1.2",
    "@webxdc/vite-plugins": "^1.5.1",
    "base64-arraybuffer": "^1.0.2",
    "i18next": "^26.3.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^16.5.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@webxdc/webxdc-dev": "^0.21.0",
    "concurrently": "^10.0.3",
    "typescript": "6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-svgr": "^5.2.0"
  }
}
